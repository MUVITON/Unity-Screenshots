<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/com.muviton.screenshots/Editor/Window/ScreenshotsWindow.uss?fileID=7433441132597879392&amp;guid=efcda6f620de71a428493c4b9f3cc50f&amp;type=3#ScreenshotsWindow"/>
    <engine:VisualElement name="screen-record-window" style="flex-grow: 1; -unity-font-style: bold; font-size: 15px;">
        <editor:ObjectField label="Camera:" name="camera-source" type="UnityEngine.Camera, UnityEngine.CoreModule"/>
        <engine:EnumField label="Oriintation:" value="Landscape" type="Screenshots.Editor.ScreenshotOrientation, Screenshots.Editor" name="orientation-field" binding-path="&lt;Orientation&gt;k__BackingField"/>
        <Screenshots.Editor.InlineFoldout value="true">
            <Screenshots.Editor.FolderField name="active-folder-path"/>
            <Screenshots.Editor.FolderField name="default-folder-path" label="Default Folder:" second-button-text="R"/>
        </Screenshots.Editor.InlineFoldout>
        <engine:VisualElement name="footer-container" style="flex-grow: 1; font-size: 18px;">
            <engine:Button text="Screenshot" name="screenshot-btn"/>
            <engine:Button text="Clear Folder" name="clear-folder-btn"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
