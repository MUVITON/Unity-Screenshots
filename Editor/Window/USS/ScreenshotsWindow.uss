.window {
    padding-top: 5px;
    padding-left: 9px;
    padding-right: 9px;
    padding-bottom: 5px;
    margin-top: 0;
}

.window > * {
    margin-top: 3px;
    flex-grow: 1;
    margin-bottom: 3px;
}

.icon-btn {
    height: 20px;
    margin-bottom: 0;
    margin-top: 0;
    min-width: 22px;
}

.icon-btn--selected {
    background-color: var(--unity-colors-highlight-background);
    color: var(--unity-colors-highlight-text);
}

.icon-btn--selected:hover {
    background-color: var(--unity-colors-highlight-background-hover-lighter);
}


