.window {
    padding-top: 5px;
    padding-left: 9px;
    padding-right: 9px;
    padding-bottom: 5px;
    margin-top: 0;
}

.window > * {
    margin-top: 2.5px;
    flex-grow: 1;
    margin-bottom: 2.5px;
}

.auto-mode-btn--active {
    background-color: var(--unity-colors-toolbar_button-background-checked);
    color: var(--unity-colors-toolbar_button-text-checked);
}

.file-name__dot {
    -unity-text-align: lower-left;
}

.file-name__type {
    width: 50px;
}

.variables-legend {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    padding: 6px 8px;
    margin-top: 4px;
    margin-bottom: 8px;
    border-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
}

.variables-legend__row {
    flex-direction: row;
}

.variables-legend__tag {
    width: 20px;
    color: rgb(153, 153, 153);
    font-size: 11px;
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 0;
}

.variables-legend__desc {
    color: rgb(153, 153, 153);
    font-size: 11px;
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 0;
}

.footer {
    flex-wrap: nowrap;
    flex-direction: column;
    max-width: 500px;
    flex-grow: 1;
    align-self: center;
    flex-basis: auto;
    width: 100%;
}

.footer > * {
    flex-grow: 1;
    flex-shrink: 0;
}

.footer__row {
    flex-direction: row;
}

.footer__row > * {
    flex-grow: 1;
    flex-shrink: 0;
}
