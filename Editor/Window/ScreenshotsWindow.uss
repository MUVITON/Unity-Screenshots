#screen-record-window {
    margin-left: 18px;
    margin-right: 15px;
    margin-top: 15px;
    font-size: 48px;
}

#screen-record-window > * {
    margin-bottom: 7px;
}

#screen-record-window #folder-path-container {
    flex-direction: row;
    justify-content: center;
    align-content: auto;
    flex-wrap: nowrap;
    flex-basis: auto;
}

#screen-record-window #folder-path-container > * {
    flex-grow: 1;
}

#screen-record-window #folder-path-field {
    flex-grow: 1;
    width: 80%;
}

#screen-record-window #footer-container {
    flex-direction: row;
    justify-content: flex-start;
    align-content: auto;
    align-self: auto;
    align-items: flex-start;
}

#screen-record-window #footer-container > Button {
    font-size: 18px;
    flex-grow: 1;
    flex-shrink: 1;
}

.auto-mode-btn--active {
    background-color: var(--unity-colors-toolbar_button-background-checked);
    color: var(--unity-colors-toolbar_button-text-checked);
}

.variables-legend {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    padding: 6px 8px;
    margin-top: 4px;
    margin-bottom: 8px;
    border-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
}

.variables-legend__row {
    flex-direction: row; 
}

.variables-legend__tag {
    width: 20px; 
    color: #999999;
    font-size: 11px;
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 0;
}

.variables-legend__desc {
    color: #999999;
    font-size: 11px;
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 0;
}


