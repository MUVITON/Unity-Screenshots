.window {
    padding-top: 5px;
    padding-left: 9px;
    padding-right: 9px;
    padding-bottom: 5px;
    margin-top: 0;
}

.window > * {
    margin-top: 3px;
    flex-grow: 1;
    margin-bottom: 3px;
}

.auto-mode-btn--active {
    background-color: var(--unity-colors-highlight-background);
    color: var(--unity-colors-highlight-text);
}

.auto-mode-btn--active:hover {
    background-color: var(--unity-colors-highlight-background-hover-lighter);
}

.file-name__dot {
    -unity-text-align: lower-left;
}

.file-name__type {
    width: 50px;
}

.variables-legend {
    background-color: var(--unity-colors-helpbox-background);
    border-radius: 4px;
    padding: 6px 8px;
    margin-top: 4px;
    margin-bottom: 8px;
    border-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-top-color: var(--unity-colors-helpbox-border);
    border-right-color: var(--unity-colors-helpbox-border);
    border-bottom-color: var(--unity-colors-helpbox-border);
    border-left-color: var(--unity-colors-helpbox-border);
    color: var(--unity-colors-helpbox-text);
}

.variables-legend__row {
    flex-direction: row;
}

.variables-legend__tag {
    width: 20px;
    font-size: 11px;
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 0;
}

.variables-legend__desc {
    font-size: 11px;
    -unity-text-align: middle-left;
    margin: 1px 0;
    padding: 0;
}

.footer {
    flex-wrap: nowrap;
    flex-direction: column;
    max-width: 500px;
    flex-grow: 1;
    align-self: center;
    flex-basis: auto;
    width: 100%;
    margin-top: 15px;
}

.footer > * {
    flex-grow: 1;
    flex-shrink: 0;
}

.footer__row {
    flex-direction: row;
}

.footer__row > * {
    flex-grow: 1;
    flex-shrink: 0;
}
