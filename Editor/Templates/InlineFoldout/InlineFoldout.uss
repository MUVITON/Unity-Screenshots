.inline-foldout {
    align-items: flex-start;
}

.inline-foldout > .inline-foldout__content {
    flex-grow: 1;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.298);
    border-right-color: rgba(0, 0, 0, 0.298);
    border-top-color: rgba(0, 0, 0, 0.298);
    border-bottom-color: rgba(0, 0, 0, 0.298);
    padding-top: 1px;
    padding-bottom: 1px;
    padding-right: 8px;
    padding-left: 8px;
    background-color: rgb(53, 53, 53);
}

.inline-foldout__child {
    margin-top: 2px;
    margin-bottom: 2px;
}

.inline-foldout .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    margin-top: 3px;
}

.inline-foldout > .unity-toggle__input > .unity-toggle__checkmark {
    align-self: center;
    margin-left: 0;
    margin-right: 5px;
    margin-top: 6px;
    -unity-slice-left: 13;
    -unity-slice-top: 13;
    background-image: resource("uipackageresources/images/d_in_foldout.png");
    width: 13px;
    height: 13px;
}

.inline-foldout > .unity-toggle__input:checked > .unity-toggle__checkmark {
    background-image: resource("uipackageresources/images/d_in_foldout_on.png");
}
